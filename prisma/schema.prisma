// DukaanFlow — Prisma schema
//
// MONEY IS STORED AS INTEGER PAISE EVERYWHERE. Never floats, never rupees.
//
// Every column holding money says "Paise" in its name. That is not decoration:
// a rupee figure and a paise figure are both plain integers, so nothing but the
// name stops one being written where the other is expected, and the symptom of
// getting it wrong is a price that is a hundred times off in somebody's shop.
// If a field holds money and does not say Paise, it is a bug.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShopType {
  GROCERY
  RESTAURANT
  TEA_STALL
  ROLL_MOMO
  HOME_KITCHEN
  BAKERY
  OTHER
}

enum OrderType {
  DELIVERY
  PICKUP
}

/// The life of one order, in the order an owner works it. `asc` on this enum is
/// the queue: what still needs doing first, what is finished last.
///
/// CONFIRMED and COMPLETED are deliberately separate. "I have taken this order"
/// and "the customer has it" are different moments, and the gap between them is
/// the only thing an owner is actually tracking during a rush.
enum OrderStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Billing tier. The limit that goes with each lives in lib/plans.ts, so
/// pricing can change without a migration.
enum Plan {
  FREE
  STARTER
  PRO
  EX
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// DEBIT — the customer took goods and owes more.
/// CREDIT — the customer paid some of it back.
enum LedgerKind {
  DEBIT
  CREDIT
}

model Shop {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String    @unique
  type                 ShopType  @default(GROCERY)
  phone                String // 10-digit Indian mobile, digits only
  address              String    @default("")
  upiId                String    @default("")
  active               Boolean   @default(true)
  // Owner access: a bcrypt hash of the 6-digit PIN the Super Admin issues to
  // this shop's owner. Null means the owner cannot sign in at all, which is
  // the default — access is granted deliberately, never by existing.
  ownerPinHash         String?
  ownerPinSetAt        DateTime?
  /// One-time invite link, so an owner's first open needs no PIN typing.
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?

  /// When the shutter goes up and comes down, as "HH:MM" in shop time, or
  /// blank when the owner has not said.
  ///
  /// Shown to customers and nothing more. It does NOT close the shop page or
  /// refuse orders: a kirana keeps serving whoever is still at the counter at
  /// closing time, and software that hard-stops at 21:00 would be wrong about
  /// the shop rather than the shop being wrong about itself. `active` remains
  /// the switch that actually stops orders.
  openTime   String @default("")
  closeTime  String @default("")
  /// Why the shop is shut, in the shopkeeper's own words — "closed today,
  /// family function", "back at 5". Shown to customers on the closed page.
  ///
  /// A shop that is simply shut says so with `active`; this says why, which is
  /// the difference between a customer trying again tomorrow and deciding the
  /// shop has gone.
  closedNote String @default("")

  /// A notice the shopkeeper writes for their own customers, and the days it
  /// runs — "no delivery this week", "puja special orders from Friday".
  ///
  /// Separate from `closedNote`, which only ever appears on a shop that is
  /// shut. A notice belongs on a shop that is open and trading, which is when
  /// there is anybody there to read it.
  ///
  /// The dates are the point. A notice with no end is a notice nobody takes
  /// down, and a stale one is worse than none — so the storefront shows this
  /// only inside the range. Both blank means "show it until I clear it", which
  /// is the honest reading of an owner who gave no dates.
  noticeText String    @default("")
  /// Calendar days in shop time, inclusive at both ends.
  noticeFrom DateTime? @db.Date
  noticeTo   DateTime? @db.Date

  /// Does this shop deliver, or is it collection only?
  ///
  /// A kirana that has nobody to send out should not be offered as a delivery
  /// shop — a customer choosing Delivery from a shop that cannot deliver is a
  /// promise the owner never made and has to break by phone. Off means the
  /// storefront never shows the option and the order route refuses it.
  deliveryEnabled Boolean @default(true)

  /// What the shop charges to send an order out, in PAISE. Zero means free
  /// delivery, which is what nearly every kirana does inside its own para and
  /// therefore the default.
  ///
  /// Charged on DELIVERY orders only. A customer collecting from the counter is
  /// never charged for a journey nobody made.
  deliveryFeePaise Int @default(0)

  /// Order value at or above which the delivery fee is waived, in PAISE. Zero
  /// means "never waive it" — not "waive everything", which is the reading that
  /// would give away every delivery in the shop on the day somebody left the
  /// box empty.
  freeDeliveryAbovePaise Int @default(0)

  /// The smallest order the shop will send out, in PAISE. Zero means no
  /// minimum.
  ///
  /// Checked on DELIVERY only, and checked on the goods — the delivery fee is
  /// not part of what a shop is willing to travel for. Enforced at the server
  /// as well as in the basket: the storefront saying "₹50 more" is a courtesy,
  /// refusing the order is the rule.
  minOrderPaise Int @default(0)

  /// A demonstration shop, not a real customer.
  ///
  /// Marked rather than deleted so there is always something to show, test a
  /// release against, or walk a prospect through — and marked rather than
  /// guessed at by name, because "Demo Store" is a name a real shop could
  /// choose. The console hides these behind a toggle so they never quietly
  /// inflate a count of how many shops are live.
  isDemo Boolean @default(false)

  /// The Indian state this shop trades in, as a code from `lib/states.ts`.
  /// Blank until somebody fills it in. It exists for one reason: occasions are
  /// regional — Pohela Boishakh moves goods in West Bengal and nothing in
  /// Tamil Nadu — so a shop must be placed before its festivals can be.
  state String @default("")

  /// Whoever runs the deliveries, as a 10-digit mobile, or blank.
  ///
  /// Not a user: the delivery boy has no login and never will — he has a phone
  /// with WhatsApp on it, which is the whole of it. This is only so the owner
  /// can forward the round to him in one tap instead of dictating four
  /// addresses at six in the evening. Blank means the send button opens
  /// WhatsApp's own contact picker instead.
  labourPhone    String @default("")

  ownerName      String @default("")
  /// Storefront and owner photos, held as resized data URLs. Not a blob store:
  /// one ~100 KB image per shop keeps DukaanFlow deployable with nothing but a
  /// database, and the column takes a URL unchanged if that ever changes.
  imageData      String @default("")
  ownerImageData String @default("")
  /// The shop's own printed UPI QR, photographed or exported from their
  /// payment app. Preferred over the one DukaanFlow generates from `upiId`,
  /// because a PhonePe or Paytm QR carries merchant details a plain
  /// `upi://pay` link cannot reproduce.
  upiQrData      String @default("")

  /// The owner's own language, used by their app. Customers pick their own.
  locale String @default("en")

  plan               Plan      @default(FREE)
  subscriptionStatus SubStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  /// When this shop first listed an item — the activation metric.
  activatedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         Item[]
  orders        Order[]
  sales         Sale[]
  payments      Payment[]
  customers     Customer[]
  ledger        LedgerEntry[]
  itemStats     ItemPeriodStat[]
  areaStats     AreaPeriodStat[]
  subscriptions PushSubscription[]

  @@index([active])
  @@index([subscriptionStatus])
  @@index([state])
  @@index([isDemo])
}

/// A recorded payment. DukaanFlow collects over UPI and the Super Admin records
/// it here; the shape is deliberately gateway-shaped so a Razorpay or Stripe
/// webhook can write the same rows without a migration.
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  /// What the shop paid DukaanFlow. The listing service is priced at 50 paise
  /// an item, so this needs the finer unit even when every plan price is whole.
  amountPaise Int
  plan        Plan
  /// "SUBSCRIPTION" — bought time on a plan.
  /// "LISTING" — the operator catalogued the shop's items, charged per item.
  ///
  /// A string rather than an enum so the set can grow without a migration, and
  /// separate from `method` because that says how the money arrived, not what
  /// it bought. Service revenue and subscription revenue answer different
  /// questions and must not be summed as one number by accident.
  kind        String   @default("SUBSCRIPTION")
  /// For a LISTING charge, how many items were listed. Zero otherwise.
  itemsListed Int      @default(0)
  /// Equal for a one-off charge, which buys no time.
  periodStart DateTime
  periodEnd   DateTime
  /// "UPI", "CASH", "RAZORPAY", …
  method      String   @default("UPI")
  /// UTR number, gateway payment id, or whatever identifies it externally.
  reference   String   @default("")
  note        String   @default("")
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// A counter sale — the owner ringing something up in the shop, as opposed to
/// an `Order` that arrived from a customer's phone. Kept separate because they
/// answer different questions: orders are a queue to work through, sales are
/// what the day took.
model Sale {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @db.Uuid
  /// Immutable snapshot: name, unit, quantity and the price charged, in PAISE.
  /// Keys inside carry the unit in their names too (`pricePaise`,
  /// `amountPaise`) — JSON gets no help from the compiler, so the name is the
  /// only thing standing between a reader and a hundredfold error.
  itemsJson        Json
  totalAmountPaise Int
  /// "CASH" or "UPI".
  paymentMode      String   @default("CASH")
  createdAt        DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// A named regular of one shop, keyed by phone.
///
/// Exists for udhaar — the credit book every kirana already keeps on paper —
/// and, later, for telling those regulars what is cooking today. Scoped to a
/// single shop on purpose: one shopkeeper's customer list is not another's, and
/// DukaanFlow is not in the business of pooling them.
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  name      String   @default("")
  phone     String // 10-digit Indian mobile, digits only
  /// Where they live, as last given on an order. Kept on the customer so the
  /// console can show it without reading back through their orders — and so a
  /// delivery still has an address after those orders are purged.
  address   String   @default("")
  /// Which para, lane or block this regular is from.
  ///
  /// Where they order from, and how a shopkeeper tells two Rekhas apart. The
  /// phone number is the key, but nobody recognises anybody by one.
  area      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]

  @@unique([shopId, phone])
  @@index([shopId, name])
}

/// One line of the credit book. The balance is always derived by summing these,
/// never stored: a running total that can drift from its own history is how a
/// paper khata starts an argument, and the whole point is to end those.
model LedgerEntry {
  id          String     @id @default(uuid()) @db.Uuid
  shopId      String     @db.Uuid
  customerId  String     @db.Uuid
  kind        LedgerKind
  amountPaise Int // always positive; the kind decides the direction
  note        String     @default("")
  /// Set when the entry came from a counter sale rung up on credit.
  saleId      String?    @db.Uuid
  /// Set when it came from a WhatsApp order the owner completed unpaid.
  /// Unique, so an order can never be posted to the khata twice — a double tap
  /// on "not paid yet" would otherwise double what the customer owes.
  orderId     String?    @unique @db.Uuid
  createdAt   DateTime   @default(now())

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([customerId, createdAt])
}

model Item {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @db.Uuid
  // `name` is the primary name and always set — it is what a customer sees
  // when their own language is blank. The other two are optional overrides.
  name       String
  nameBn     String   @default("")
  nameHi     String   @default("")
  pricePaise Int
  /**
   * Has a human actually chosen this price?
   * This used to be inferred from `price > 1`, which was wrong in a way that
   * cost a shop its whole storefront: a kirana really does sell a toffee, a
   * matchbox or a single biscuit for one rupee, and every one of them was
   * silently hidden from customers as "not priced yet".
   * Items arriving from the starter catalogue, voice or a photograph land here
   * `false` at a placeholder Re 1 — an invented price is worse than no item at
   * all. The moment somebody sets a price, any price, this becomes true and the
   * item goes on sale. One rupee chosen and one rupee never touched are
   * different facts, and only a separate column can tell them apart.
   */
  priced     Boolean  @default(false)
  unit       String   @default("")
  category   String   @default("")
  inStock    Boolean  @default(true)

  /**
   * How many are left, or NULL for "nobody is counting".
   *
   * NULL is the default and stays the honest one for most of a kirana's list.
   * Rice comes out of a sack, sugar off a scale, and a shopkeeper weighing to
   * order does not have a number of kilos to type in each morning — asking for
   * one would get a wrong number typed once and never touched again, which is
   * worse than no number at all. Those items keep `inStock` as their only
   * answer, exactly as before.
   *
   * A number is for the countable half of the shop: packets, bottles, bread,
   * eggs, gas lighters. Once it is set, selling decrements it — through the
   * storefront and through the till alike — and it is what stops a customer
   * ordering the two kilos of basmati that went an hour ago.
   *
   * `inStock` remains the switch the whole product reads. Hitting zero turns it
   * off, and raising the count turns it back on, so nothing downstream has to
   * learn about a second kind of "available".
   */
  stockQty   Int?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name, unit])
  @@index([shopId])
  @@index([shopId, inStock])
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  shopId           String      @db.Uuid
  customerName     String      @default("")
  customerPhone    String
  customerAddress  String      @default("")
  /// The para or lane, in the customer's own words. How a delivery is actually
  /// found, how a shopkeeper recognises a regular, and what the locality report
  /// groups on.
  customerArea     String      @default("")
  orderType        OrderType   @default(DELIVERY)
  // Immutable snapshot of what was ordered, at the price charged at that
  // moment, in PAISE — see the note on Sale.itemsJson about naming.
  // Reporting reads `totalAmountPaise`; it is never recomputed from this JSON.
  itemsJson        Json
  /// The grand total the customer owes: goods plus `deliveryFeePaise`.
  ///
  /// Unchanged in meaning — every report, rollup and khata posting already
  /// reads this as "what this order came to", and a delivery charge is money
  /// the shop took. The fee is broken out below so a bill can show it, not so
  /// anything has to add it back on.
  totalAmountPaise Int
  /// What was charged for sending it out, in PAISE, at the moment it was
  /// ordered. A snapshot for the same reason the prices are: the shop may
  /// change its delivery charge tomorrow and this bill must not move.
  deliveryFeePaise Int         @default(0)
  status           OrderStatus @default(NEW)

  /// When the owner last changed what is actually in this order.
  ///
  /// A customer asks for two kilos and the sack has one left. The shop does not
  /// want to cancel — they want to send the one kilo — and until now the only
  /// way to say so was a phone call, with the app still insisting on a total
  /// nobody is going to pay. Cutting the line here rewrites the snapshot and
  /// the total, and stamps this so both sides can see the order was changed
  /// after it was placed rather than mis-read at the counter.
  revisedAt        DateTime?
  /// How the money arrived: "CASH", "UPI" or "" while unpaid.
  ///
  /// Without this the till was the only screen that could take a payment, so an
  /// owner whose customer wanted to scan a UPI code had to open Sell and tap
  /// the items in again — creating a second record of one sale. The double
  /// count was never carelessness; the app was sending them there.
  paymentMode      String      @default("")
  /// Did the money arrive? Only meaningful once the order is COMPLETED.
  ///
  /// Completing an order without this posts the total to the customer's khata,
  /// because goods that left the shop unpaid are a debt whether or not anybody
  /// writes it down — and not writing it down is the thing DukaanFlow exists
  /// to end.
  paymentReceived  Boolean     @default(false)
  createdAt        DateTime    @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status])
  @@index([shopId, customerArea])
}

/// Who a push subscription belongs to.
///
/// OWNER — a phone the shopkeeper signed in on. It is told about new orders.
/// CUSTOMER — a phone that placed an order. It is told what happened to it.
enum PushRole {
  OWNER
  CUSTOMER
}

/// One browser, on one phone, that has agreed to be told something.
///
/// A row per device, not per person: an owner with a counter tablet and a phone
/// in their pocket wants the sound on both, and a customer who orders from two
/// phones has two.
///
/// PUSH IS AN ACCELERATOR, NEVER THE SYSTEM OF RECORD. Xiaomi, Oppo, Vivo and
/// Realme all kill background processes hard, and this market is made of those
/// phones — a push can arrive late or not at all and nothing in code can fix
/// it. So the orders screen, the WhatsApp button and the tracking page all keep
/// working exactly as they do without this table, and nothing in the product
/// ever promises a shopkeeper they will be told. It is a sound on top.
model PushSubscription {
  id     String   @id @default(uuid()) @db.Uuid
  role   PushRole
  shopId String   @db.Uuid

  /// The push service's URL for this device. Unique because it IS the device:
  /// re-subscribing the same browser must update the row, never add a second.
  endpoint String @unique
  /// The two keys the payload is encrypted to, base64url as the browser gave
  /// them. Useless to anyone else — they encrypt to that device and nothing
  /// else — but they are still the customer's, so they are purged with them.
  p256dh   String
  auth     String

  /// Which customer this device is, as their 10-digit mobile. Blank for an
  /// owner's device.
  ///
  /// The phone number rather than a `Customer` id: a customer row can be purged
  /// and re-made, and the number is what an order carries anyway.
  customerPhone String @default("")

  /// When this device was last confirmed alive. A subscription the push
  /// service rejects with 404 or 410 is deleted on the spot instead.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, role])
  @@index([shopId, customerPhone])
}

/// A named occasion. The name, and nothing that changes from year to year.
///
/// Entered ONCE and left alone: "Durga Puja" is one row forever, not one row per
/// year. The name is what year-over-year comparison groups on, so keeping it in
/// a single place is what stops "Durga Puja" and "Durga puja" becoming two
/// festivals to every report downstream.
///
/// `state` is blank for occasions kept all over India. Regional ones are scoped,
/// because an occasion that moves nothing in a shop's own state is noise in that
/// shop's report.
///
/// WHEN IT FALLS lives in one of two places, and an occasion needs exactly one:
///
///  - `fixedMonth`/`fixedDay` — for occasions on the Gregorian calendar, which
///    never move. Independence Day is the 15th of August every year and always
///    will be. These need no yearly upkeep at all, ever.
///  - `OccasionDate` — for occasions on a lunar or solar-religious calendar,
///    which move by weeks. Somebody has to say when Diwali fell; no software can
///    derive it, and guessing would put a wrong festival boundary into every
///    report permanently.
///
/// An occasion with neither simply does not appear in a report for that year,
/// and the console says which ones are waiting.
model Occasion {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  /// A state code from `lib/states.ts`, or "" for all of India.
  state String @default("")

  /// 1–12 and 1–31 for an occasion that never moves; null when it does.
  fixedMonth Int?
  fixedDay   Int?
  /// How many days it runs, counting the first. Pongal is 4, Christmas is 1.
  spanDays   Int  @default(1)

  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dates OccasionDate[]

  /// One entry per name per state. The point of the whole table.
  @@unique([name, state])
  @@index([state])
}

/// The days one moving occasion actually fell on, in one year.
///
/// Only for occasions that move. A fixed-date occasion never has a row here —
/// its dates are computed from `fixedMonth`/`fixedDay` for whatever year is
/// being reported.
model OccasionDate {
  id         String   @id @default(uuid()) @db.Uuid
  occasionId String   @db.Uuid
  year       Int
  /// Inclusive first and last day, as calendar dates in shop time.
  startsOn   DateTime @db.Date
  endsOn     DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([occasionId, year])
  @@index([year])
}

/// What one item took, in one shop, over one year or one occasion inside it.
///
/// THIS TABLE EXISTS TO SURVIVE THE PURGE. Orders and sales are deleted on each
/// shop's subscription anniversary (see `lib/retention.ts`), which would make
/// year-over-year comparison permanently impossible: you cannot say "Durga Puja
/// sold better this year" when last year's orders were deleted before this
/// year's arrived. So the totals are rolled up here first — a few rows per shop
/// per year instead of thousands — and these are never purged.
///
/// Item name and unit are stored, not an item id. The item may be renamed,
/// re-priced or deleted; what it took in 2026 may not change with it.
model ItemPeriodStat {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid
  year   Int

  /// `""` for the whole year; otherwise the `Occasion.id` this covers.
  ///
  /// A sentinel rather than a nullable column on purpose: in Postgres two NULLs
  /// are never equal, so a nullable field in the unique key below would let the
  /// whole-year row be inserted again on every rollup instead of being updated.
  occasionKey  String @default("")
  /// The occasion's name as it stood when this was computed. Renaming or
  /// deleting the occasion must not rewrite what a past year is labelled.
  occasionName String @default("")

  itemName String
  itemUnit String @default("")

  quantity     Int
  revenuePaise Int
  transactions Int

  computedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, year, occasionKey, itemName, itemUnit])
  @@index([shopId, year])
  @@index([occasionName, year])
}

/// Where a shop's customers ordered from, by area, over one year.
///
/// The locality half of the same problem `ItemPeriodStat` solves: areas are
/// only on orders, and orders are purged. Rolled up before that happens.
model AreaPeriodStat {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid
  year   Int
  /// The para or lane, as the customer wrote it. Never blank — orders with no
  /// area are simply not counted here, and the report says how many those were
  /// rather than inventing a row.
  ///
  /// This was a pincode. A six-digit code aggregates perfectly and nobody in a
  /// para thinks in one; asking for it bought tidy grouping at the cost of a
  /// field customers skipped. The area they already type is the answer they
  /// were going to give anyway.
  area   String

  orders       Int
  revenuePaise Int
  /// Distinct phone numbers that ordered from this area.
  customers    Int

  computedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, year, area])
  @@index([shopId, year])
}
