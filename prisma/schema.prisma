// DukaanFlow — Prisma schema
// Money is stored as INTEGER RUPEES everywhere. No floats, no paise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShopType {
  GROCERY
  RESTAURANT
  TEA_STALL
  ROLL_MOMO
  HOME_KITCHEN
  BAKERY
  OTHER
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  NEW
  CONFIRMED
  CANCELLED
}

/// Billing tier. The limit that goes with each lives in lib/plans.ts, so
/// pricing can change without a migration.
enum Plan {
  FREE
  STARTER
  PRO
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  type      ShopType @default(GROCERY)
  phone     String // 10-digit Indian mobile, digits only
  address   String   @default("")
  upiId     String   @default("")
  active    Boolean  @default(true)
  // Owner access: a bcrypt hash of the 6-digit PIN the Super Admin issues to
  // this shop's owner. Null means the owner cannot sign in at all, which is
  // the default — access is granted deliberately, never by existing.
  ownerPinHash  String?
  ownerPinSetAt DateTime?
  /// One-time invite link, so an owner's first open needs no PIN typing.
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?

  ownerName String @default("")
  /// Storefront and owner photos, held as resized data URLs. Not a blob store:
  /// one ~100 KB image per shop keeps DukaanFlow deployable with nothing but a
  /// database, and the column takes a URL unchanged if that ever changes.
  imageData      String @default("")
  ownerImageData String @default("")

  /// The owner's own language, used by their app. Customers pick their own.
  locale String @default("en")

  plan               Plan      @default(FREE)
  subscriptionStatus SubStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  /// When this shop first listed an item — the activation metric.
  activatedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    Item[]
  orders   Order[]
  sales    Sale[]
  payments Payment[]

  @@index([active])
  @@index([subscriptionStatus])
}

/// A recorded payment. DukaanFlow collects over UPI and the Super Admin records
/// it here; the shape is deliberately gateway-shaped so a Razorpay or Stripe
/// webhook can write the same rows without a migration.
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  amount      Int // INTEGER RUPEES
  plan        Plan
  periodStart DateTime
  periodEnd   DateTime
  /// "UPI", "CASH", "RAZORPAY", …
  method      String   @default("UPI")
  /// UTR number, gateway payment id, or whatever identifies it externally.
  reference   String   @default("")
  note        String   @default("")
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// A counter sale — the owner ringing something up in the shop, as opposed to
/// an `Order` that arrived from a customer's phone. Kept separate because they
/// answer different questions: orders are a queue to work through, sales are
/// what the day took.
model Sale {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  /// Immutable snapshot: name, unit, quantity and the price charged.
  itemsJson   Json
  totalAmount Int // INTEGER RUPEES
  /// "CASH" or "UPI".
  paymentMode String   @default("CASH")
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

model Item {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  // `name` is the primary name and always set — it is what a customer sees
  // when their own language is blank. The other two are optional overrides.
  name      String
  nameBn    String   @default("")
  nameHi    String   @default("")
  price     Int // INTEGER RUPEES
  unit      String   @default("")
  category  String   @default("")
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name, unit])
  @@index([shopId])
  @@index([shopId, inStock])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  shopId          String      @db.Uuid
  customerName    String      @default("")
  customerPhone   String
  customerAddress String      @default("")
  orderType       OrderType   @default(DELIVERY)
  // Immutable snapshot of what was ordered, at the price charged at that moment.
  // Reporting reads `totalAmount`; it is never recomputed from this JSON.
  itemsJson       Json
  totalAmount     Int
  status          OrderStatus @default(NEW)
  createdAt       DateTime    @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status])
}
