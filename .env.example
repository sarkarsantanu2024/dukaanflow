# ---------------------------------------------------------------------------
# Halkhata — environment variables
# Copy to `.env` for local dev. Never commit `.env`.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string (used by the app at runtime).
# Neon dashboard → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/halkhata?sslmode=require"

# Direct (non-pooled) connection — required by `prisma migrate`.
# Neon dashboard → Connection Details → uncheck "Pooled connection".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/halkhata?sslmode=require"

# Super Admin username. An identifier, not a secret, so it is stored in plain
# text; matching is case-insensitive. Defaults to "admin" if unset.
ADMIN_USERNAME="admin"

# bcrypt hash of the single Super Admin password.
# Generate with:  npm run hash -- "your-strong-password"
#
# IMPORTANT: Next.js expands `$name` inside .env files, so a raw bcrypt hash
# ($2a$12$....) gets silently mangled and every login fails with "Incorrect
# password". Escape every `$` as `\$` HERE, as shown below.
# In Vercel's env UI paste the RAW hash with no backslashes — values set there
# are injected directly and are never expanded.
ADMIN_PASSWORD_HASH="\$2a\$12\$replace_me_with_a_real_bcrypt_hash"

# Public origin, used to build every QR target and shop link. No trailing slash.
# Keep this on the real domain even in local dev — a QR generated locally is
# still meant to be printed and scanned by a customer in the street.
NEXT_PUBLIC_BASE_URL="https://dukaanflow.vercel.app"

# Random 32+ byte secret used to HMAC-sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="replace_me_with_64_hex_chars"

# The Halkhata operator's own WhatsApp number, with country code and digits
# only (e.g. 919876543210). Owners tap "Upgrade" and land in a chat with you;
# leave it blank and they are sent to /pricing instead.
NEXT_PUBLIC_SUPPORT_PHONE=""

# Anthropic API key, for reading an item's name off a photograph in the owner
# app and the console. Get one at https://console.anthropic.com/settings/keys
#
# Optional. Leave it blank and every other way of listing an item — the mic,
# the typed form, the common-items list — works exactly as before; only "Add by
# photo" reports that it is not switched on.
#
# The photo itself is never stored: it is read and dropped, and what is kept is
# the item, which is text.
ANTHROPIC_API_KEY=""

# Nightly retention purge (vercel.json). Requests to /api/cron/purge must carry
# this as a bearer token; without it the route answers 503 and Order and Sale
# grow forever.
CRON_SECRET=""

# Web push — the sound a shopkeeper's phone makes when an order arrives, and
# the message a customer gets when theirs is ready. Generate a pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
#
# CHANGING THESE INVALIDATES EVERY EXISTING SUBSCRIPTION. Every phone that
# already said yes stops receiving, silently, and has to be asked again — and
# the browser permission prompt is one-shot, so some of them never can be. Set
# them once and leave them alone.
#
# Leave all three blank and push is simply off. Nothing else changes: the
# orders screen, the WhatsApp buttons and the tracking page all work exactly as
# they do with it on. Push is an accelerator, never the system of record.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Who a push service contacts if it has a problem with our traffic. The spec
# requires one and refuses an empty string, and it accepts either a mailto: or
# an https: URL.
#
# The site's own URL is the better answer. It is already public, it does not
# put a personal or work mailbox into a header sent to Google and Mozilla on
# every notification, and it does not go stale when somebody changes job.
VAPID_SUBJECT="https://dukaanflow.vercel.app"
