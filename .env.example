# ---------------------------------------------------------------------------
# DukaanFlow — environment variables
# Copy to `.env` for local dev. Never commit `.env`.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string (used by the app at runtime).
# Neon dashboard → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dukaanflow?sslmode=require"

# Direct (non-pooled) connection — required by `prisma migrate`.
# Neon dashboard → Connection Details → uncheck "Pooled connection".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dukaanflow?sslmode=require"

# bcrypt hash of the single Super Admin password.
# Generate with:  npm run hash -- "your-strong-password"
#
# IMPORTANT: Next.js expands `$name` inside .env files, so a raw bcrypt hash
# ($2a$12$....) gets silently mangled and every login fails with "Incorrect
# password". Escape every `$` as `\$` HERE, as shown below.
# In Vercel's env UI paste the RAW hash with no backslashes — values set there
# are injected directly and are never expanded.
ADMIN_PASSWORD_HASH="\$2a\$12\$replace_me_with_a_real_bcrypt_hash"

# Public origin, used to build every QR target and shop link. No trailing slash.
# Keep this on the real domain even in local dev — a QR generated locally is
# still meant to be printed and scanned by a customer in the street.
NEXT_PUBLIC_BASE_URL="https://dukaanflow.vercel.app"

# Random 32+ byte secret used to HMAC-sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="replace_me_with_64_hex_chars"
